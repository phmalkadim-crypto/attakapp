{
  "id": "/",
  "name": "عَتّاك | Attak - منصة مزادات الخردة والمعادن في العراق",
  "short_name": "عَتّاك",
  "description": "منصة المزادات الأولى للخردة والمعادن في العراق. عَتّاك | Attak - بيع خردتك بأعلى سعر 🔨♻️",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/"
        }
      ]
    },
    "new_tab_button": {
      "url": "/?tab=add"
    }
  },
  "orientation": "portrait",
  "background_color": "#062016",
  "theme_color": "#062016",
  "lang": "ar",
  "dir": "rtl",
  "categories": [
    "business",
    "shopping",
    "finance"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ec4e53b7",
  "scope_extensions": [
    {
      "origin": "https://attakapp.netlify.app"
    },
    {
      "origin": "https://*.netlify.app"
    },
    {
      "origin": "https://attak.app"
    },
    {
      "origin": "https://*.attak.app"
    },
    {
      "origin": "https://attak-app.web.app"
    },
    {
      "origin": "https://*.web.app"
    },
    {
      "origin": "https://*.firebaseapp.com"
    },
    {
      "origin": "https://*.run.app"
    }
  ],
  "shortcuts": [
    {
      "name": "أضف مزاد خردة جديد",
      "short_name": "أضف مزاد",
      "description": "نشر وجبة خردة جديدة في المزاد المباشر",
      "url": "/?tab=add",
      "icons": [
        {
          "src": "/icons/shortcut-add.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "المزادات النشطة والحية",
      "short_name": "المزادات",
      "description": "تصفح ومزايدة على أحدث وجبات المعادن والخردة",
      "url": "/?tab=home",
      "icons": [
        {
          "src": "/icons/shortcut-home.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "صفقاتي ومزاداتي الفائزة",
      "short_name": "صفقاتي",
      "description": "متابعة المزادات الفائزة وعمولات زين كاش",
      "url": "/?tab=deals",
      "icons": [
        {
          "src": "/icons/shortcut-deals.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "الملف الشخصي وحسابي",
      "short_name": "حسابي",
      "description": "إدارة الحساب ولوحة التحكم والتقييمات",
      "url": "/?tab=profile",
      "icons": [
        {
          "src": "/icons/shortcut-profile.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=import-scrap",
      "name": "فتح ومشاركة صور وبيانات الخردة",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+attak",
      "url": "/?auction=%s"
    }
  ],
  "share_target": {
    "action": "/?action=share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 440
  },
  "widgets": [
    {
      "name": "مزادات خردة عَتّاك المباشرة",
      "short_name": "عَتّاك",
      "description": "متابعة أسعار ومزادات قواطي الألمنيوم والنحاس والحديد لحظياً",
      "tag": "attak-scrap-widget",
      "template": "attak-widget-template",
      "ms_ac_template": "widget.json",
      "data": "/?widget=data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/mobile-screen.png",
          "sizes": "1072x1920",
          "label": "أداة مزادات عَتّاك"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/?action=note"
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.attak.app",
      "url": "https://play.google.com/store/apps/details?id=com.attak.app"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
